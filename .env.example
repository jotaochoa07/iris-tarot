# ---------------------------------------------------------------------------
# IRIS — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo servidor. Necesaria para tareas administrativas puntuales.
# No la expongas nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Modelos.
#   Lectura   — calidad interpretativa. sonnet-5 equilibra bien; opus-5 si
#               quieres el máximo y no te importa el coste.
#   Visión    — identificar las cartas. haiku es el más barato; si falla mucho
#               contando los signos del palo, sube a claude-sonnet-5.
IRIS_MODEL_READING=claude-sonnet-5
IRIS_MODEL_VISION=claude-haiku-4-5-20251001

# URL pública del sitio (para el callback de magic link).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Capa 2 del corpus: búsqueda sobre los libros que TÚ has puesto en corpus/.
# Requiere haber ejecutado la migración 0002 y `node scripts/ingest-corpus.mjs`.
IRIS_CORPUS_RAG_ENABLED=false

# Destino de la API de Anthropic. Solo tócalo si sabes por qué.
# Existe porque el SDK lee ANTHROPIC_BASE_URL del entorno del sistema sin
# avisar, y eso puede desviar las llamadas a un proveedor que no es el tuyo.
IRIS_ANTHROPIC_BASE_URL=https://api.anthropic.com
